# Line endings: store text as LF in the repository and check it out as LF on every machine,
# so Windows laptops and the Linux CI never disagree (no "LF will be replaced by CRLF" noise,
# no whole-file diffs). Windows editors (VS Code, Notepad++, Notepad) handle LF.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never convert, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.parquet binary
*.npy   binary
*.npz   binary
*.h5    binary
*.nc    binary

# Generated files: collapsed in GitHub diffs.
env/conda-lock.yml linguist-generated=true
